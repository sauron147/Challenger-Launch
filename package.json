{
  "name": "maple-battle-practice-dashboard",
  "version": "1.0.0",
  "description": "MapleStory 유니온 & 연무장 분석 대시보드",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.maple.bpdashboard",
    "productName": "MapleStory_연무장_분석기",
    "asar": true,
    "files": [
      "main.js",
      "index.html",
      "app.js",
      "style.css",
      "job_utility_db.js",
      "simulator.html",
      "simulator.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}_v${version}_완전체배포용.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
